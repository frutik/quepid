<%= form_with url: ai_judge_prompt_path, model: ai_judge, data: { controller: "prompt-form", action: "submit->prompt-form#submit" } do |form| %>
  <% if ai_judge.errors.any? %>
    <div style="color: red">
      <h2><%= pluralize(ai_judge.errors.count, "error") %> prohibited this Prompt from being saved:</h2>

      <ul>
        <% ai_judge.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%= hidden_field_tag :book_id, @book.id if @book%>

  <% prompt_label = @provider&.prompt_label || 'System prompt' %>
  <div class="row gx-5">
    <div class="col-md-6">
      <h2><%= prompt_label.titleize %></h2>
      <div>
        <div>
          <%= form.textarea :system_prompt, class: "form-control", rows: 20  %>
          <% if @provider&.prompt_hint.present? %>
            <div class="form-text"><%= @provider.prompt_hint %></div>
          <% end %>
          <%# A judge created (or switched) before this provider existed keeps text written
              for another dialect -- for Jev that means a hardcoded 0-3 scale and a response
              format it cannot follow. Say so, and offer the right default. %>
          <% if @provider&.stock_prompt_from_another_provider?(ai_judge.system_prompt) %>
            <div class="alert alert-warning mt-2 mb-0 small" id="prompt-dialect-warning">
              These are another provider's default instructions, written for a different kind of model.
              <button type="button" class="btn btn-sm btn-outline-secondary ms-1"
                      data-use-default-prompt
                      data-default-prompt="<%= @provider.default_system_prompt %>">
                Use <%= @provider.label %>'s default
              </button>
            </div>
          <% end %>
        </div>
        <div>
          <p/>
        </div>
        <%# The other half of what gets sent: for a typed model the book's scale IS the
            question's criteria, so show them here rather than making people guess. %>
        <% scale = JudgeScale.for(@book) %>
        <% if @book && scale.present? %>
          <div class="mt-3" id="judging-criteria">
            <h3 class="h6 mb-1">
              <%= @provider&.scale_as_criteria? ? 'Criteria sent with the question' : 'Rating scale added to the prompt' %>
              <small class="text-muted fw-normal">&mdash; from <%= link_to @book.name, book_path(@book) %>'s scale</small>
            </h3>
            <% if @provider&.scale_as_criteria? %>
              <table class="table table-sm table-borderless small mb-1 w-auto">
                <tbody>
                  <% scale.values.each_with_index do |value, level| %>
                    <tr>
                      <td class="pe-3 text-muted">level <%= level %> &rarr; rating <strong><%= value %></strong></td>
                      <td><%= scale.criteria[level] %></td>
                    </tr>
                  <% end %>
                </tbody>
              </table>
            <% else %>
              <p class="small mb-1"><%= scale.describe %></p>
            <% end %>
            <div class="form-text">Read-only here. Edit the labels in the book's settings to change them.</div>
          </div>
        <% end %>

        <div>
          <%= form.submit 'Run Judgement', class: 'btn btn-primary' %>

          <div class="d-grid gap-2 mt-2">
            <%= link_to 'Back', judgement_stats_book_path(@book), method: :get, class: 'btn btn-light' if @book %>
            <%# a judge removed from its team has nowhere to be edited; the rest of this page still works %>
            <% if (judge_team = @ai_judge.teams.first) %>
              <%= link_to 'Edit Judge', edit_team_ai_judge_path(team_id: judge_team.id, id: @ai_judge.id), method: :get, class: 'btn btn-light' %>
            <% end %>
          </div>
        </div>
      </div>
      <!-- Loading spinner shown during form submission -->
      <div data-prompt-form-target="loadingSpinner" style="display: none;">
        <h2>Rating Information</h2>
        <div class="text-center my-4">
          <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Loading...</span>
          </div>
          <p class="mt-2">Evaluating with AI Judge...</p>
        </div>
      </div>

      <!-- Rating information shown after response -->
      <div data-prompt-form-target="ratingInfo">
        <% if @judgement %>
          <h2>Rating Information</h2>
          <div>
            LLM Response:
            <% if @judgement.unrateable? %>
              <span class="badge text-bg-warning">Unrateable</span>
            <% else %>
              <%= @judgement.rating %>
            <% end %>
            <br/>

            <%= @judgement.explanation %>
          </div>
        <% end %>
      </div>
    </div>
    <div class="col-md-6">
      <h2>Query Doc Pair to Evaluate</h2>
      <div>
        <% if @book %>
          <div class="d-grid mb-2">
            <%= link_to 'Change Query Doc Pair', edit_ai_judge_prompt_path(@ai_judge, book_id: @book.id), class: 'btn btn-light', role: 'button', method: :get %>
          </div>
        <% end %>
        <%= fields_for :query_doc_pair, query_doc_pair do |query_doc_pair_fields| %>

          <div class="field">
            <%= query_doc_pair_fields.label :query_text %>
            <%= query_doc_pair_fields.text_field :query_text %>
          </div>

          <div class="field">
            <%= query_doc_pair_fields.label :doc_id, "Doc ID" %>
            <%= query_doc_pair_fields.text_field :doc_id %>
          </div>

          <div class="field">
            <%= query_doc_pair_fields.label :information_need, "Information Need" %>
            <%= query_doc_pair_fields.text_field :information_need, size: 80 %>
          </div>

          <div class="field">
            <%= query_doc_pair_fields.label :document_fields %> <small>JSON</small><br/>
            <%= query_doc_pair_fields.text_area :document_fields, value: format_json(query_doc_pair_fields.object.document_fields), data: { codemirror_mode: "json", codemirror_height: 400  } %>
          </div>

          <div class="field">
            <%= query_doc_pair_fields.label :options %> <small>JSON</small><br/>
            <%= query_doc_pair_fields.text_area :options, value: format_json(query_doc_pair_fields.object.options), data: { codemirror_mode: "json", codemirror_height: 200  } %>
          </div>

          <div class="field">
            <%= query_doc_pair_fields.label :notes %><br/>
            <%= query_doc_pair_fields.text_area :notes, size: "80x8" %>
          </div>

          <div class="field">
            <%= query_doc_pair_fields.label :position %>
            <%= query_doc_pair_fields.text_field :position %>
          </div>


        <% end %>


      </div>
    </div>
  </div>


<% end %>

<script>
  document.addEventListener('click', function(event) {
    const button = event.target.closest('[data-use-default-prompt]');
    if (!button) return;

    const field = document.querySelector('textarea[name="user[system_prompt]"]');
    if (!field) return;

    field.value = button.dataset.defaultPrompt;
    document.getElementById('prompt-dialect-warning')?.remove();
  });
</script>
