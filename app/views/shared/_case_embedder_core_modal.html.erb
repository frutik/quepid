<%# locals: (kase:) %>
<%# Core case toolbar — pick the case's embedder. Laid out like the scorer picker
    (shared/_pick_scorer_core_modal): a list-group to choose from, the current one
    active, a warning when the current one isn't shared with you, and a footer link to
    create a new one. Saves through the API and stays on the page. %>
<% modal_footer = capture do %>
  <%= link_to new_embedder_path, class: 'btn btn-primary me-auto', target: '_blank', rel: 'noopener' do %>
    <i class="bi bi-plus" aria-hidden="true"></i> Create New Embedder
  <% end %>
  <button type="button" class="btn btn-success" disabled
          data-case-embedder-core-target="submitButton"
          data-action="click->case-embedder-core#save">Select Embedder</button>
<% end %>

<% modal_body = capture do %>
  <div class="alert d-none" role="alert" data-case-embedder-core-target="alert"></div>
  <div class="alert alert-warning d-none" role="alert" data-case-embedder-core-target="inaccessibleWarning"></div>

  <p class="text-muted">
    Every query in the case will be turned into a vector with this embedder, for search templates to use as
    <code>#$qOption.query_vec##</code>.
  </p>

  <%# hidden on a wrapper: Bootstrap's d-flex would override it on the same element. %>
  <div hidden data-case-embedder-core-target="vectorPanel">
    <div class="d-flex align-items-center gap-2 mb-3">
      <span class="small" data-case-embedder-core-target="vectorSummary"></span>
      <button type="button" class="btn btn-sm btn-outline-primary ms-auto"
              data-case-embedder-core-target="revectorizeButton"
              data-action="click->case-embedder-core#revectorize">Re-vectorize all queries</button>
    </div>
  </div>

  <div style="max-height: 300px; overflow-y: auto;">
    <ul class="list-group" data-case-embedder-core-target="list"></ul>
    <p class="text-muted d-none mt-2 mb-0" data-case-embedder-core-target="emptyNotice">
      No embedders are shared with you yet. Use "Create New Embedder" below to make one.
    </p>
  </div>

  <%# Result diversity: measured on a snapshot with the embedder above. Reloads when this modal opens. %>
  <section class="border-top mt-4 pt-3"
           data-controller="case-diversity-core"
           data-action="show.bs.modal@document->case-diversity-core#open"
           data-case-diversity-core-id-value="<%= kase.id %>"
           data-case-diversity-core-modal-id-value="caseEmbedderModal"
           data-case-diversity-core-embedders-url-template-value="<%= api_case_embedders_path(case_id: '__CASE_ID__') %>"
           data-case-diversity-core-snapshots-url-template-value="<%= api_case_snapshots_path(case_id: '__CASE_ID__') %>"
           data-case-diversity-core-diversity-url-template-value="<%= api_case_snapshot_diversity_path(case_id: '__CASE_ID__', snapshot_id: '__SNAPSHOT_ID__') %>"
           data-case-diversity-core-settings-url-template-value="<%= api_case_diversity_settings_path(case_id: '__CASE_ID__') %>">
    <h6>Result diversity</h6>
    <p class="text-muted small mb-2" data-case-diversity-core-target="notice" hidden></p>
    <div data-case-diversity-core-target="panel" hidden>
      <p class="text-muted small">
        How different the top results of each query are from one another: the title of each result is embedded
        and the mean pairwise cosine distance taken (0 = all alike). It is shown next to the snapshot's score
        when you compare snapshots.
      </p>
      <div class="row g-2 align-items-end mb-2">
        <div class="col-sm-7">
          <label class="form-label small mb-1" for="caseDiversitySnapshot">Snapshot</label>
          <select class="form-select form-select-sm" id="caseDiversitySnapshot"
                  data-case-diversity-core-target="snapshotSelect"
                  data-action="change->case-diversity-core#snapshotChanged"></select>
        </div>
        <div class="col-sm-3">
          <label class="form-label small mb-1" for="caseDiversityDepth">Top results</label>
          <input type="number" min="2" max="100" class="form-control form-control-sm" id="caseDiversityDepth"
                 data-case-diversity-core-target="depthInput"
                 data-action="change->case-diversity-core#saveDepth">
        </div>
        <div class="col-sm-2">
          <button type="button" class="btn btn-sm btn-outline-primary w-100"
                  data-case-diversity-core-target="computeButton"
                  data-action="click->case-diversity-core#compute">Compute</button>
        </div>
      </div>
      <div class="small mb-1">Embedded field: <code data-case-diversity-core-target="titleField"></code></div>
      <div class="small text-muted" data-case-diversity-core-target="status" role="status"></div>
    </div>
  </section>
<% end %>

<%= render "shared/modal_shell", id: "caseEmbedderModal", title: safe_join(["Which embedder should vectorize this case's queries?", render("embedders/beta")]),
                                 data: {
                                   controller: "case-embedder-core",
                                   action: "show.bs.modal->case-embedder-core#open",
                                   case_embedder_core_id_value: kase.id,
                                   case_embedder_core_index_url_template_value: api_case_embedders_path(case_id: '__CASE_ID__'),
                                   case_embedder_core_update_url_template_value: api_case_embedder_path(case_id: '__CASE_ID__', id: '__EMBEDDER_ID__'),
                                   case_embedder_core_vectorize_url_template_value: api_case_embedders_vectorize_path(case_id: '__CASE_ID__'),
                                 },
                                 title_data: { case_embedder_core_target: "title" },
                                 footer: modal_footer,
                                 body: modal_body %>
